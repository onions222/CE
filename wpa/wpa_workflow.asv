I = imread('grass.jpg'); % uint8 RGB, [0..255]

% 1) RGB -> YCoCg
I  = double(I) / 255;
% sRGB -> linear RGB
Ilin = srgb2lin(I);
Ilin255 = Ilin * 255;
[Y,Co,Cg] = rgb2ycocg(Ilin255);

% 2) Build 12-bin Kelvin tables (offline step)
opts = struct();
opts.T_warm_end  = 3500;  % can change later
opts.T_cool_end  = 9000;  % can change later
opts.xy_base     = [0.3127 0.3290]; % D65
opts.w_shadow    = 0.60;
opts.w_mid       = 1.00;
opts.w_highlight = 0.70;
opts.binMid      = 6;

% 离线表仍用你原来的 build 函数
tbl = wpa_build_tables_kelvin_12bin(opts);

% 在线改用无断层版
p = struct();
p.RGB_MAX = 255;
p.Y_dark2 = 8; 
p.Y_dark1 = 16;
p.Y_bright1 = 240; 
p.Y_bright2 = 248;
p.bright_minfac = 0.25;
p.keepY = 0;

% bin_mode instruct:
% 'uniform_linear': 均匀 bin + 插值
% 'doc_linear':     文档节点 + 插值（更平滑，通常断层更小）
% 'doc_step':       文档节点 + 硬切换（严格对齐文档，无亮度插值）

p.bin_mode = 'uniform_linear';

% 文档节点（可不写，默认就是这组）
p.docY = [15,31,47,63,95,127,159,191,223,239,247,255];


% 建议先关闭 s 量化验证最平滑
p.s_quant_en = 0;     % 如果要模拟硬件步进，改为 1
p.s_quant_Q  = 64;

wa_sel = 30; 
wa_en = 1;
[Y2,Co2,Cg2] = wpa_apply_ycocg_lms_nobanding(Y,Co,Cg, wa_sel, wa_en, tbl, p);

I2 = ycocg2rgb(Y2,Co2,Cg2);
I2 = uint8(min(max(I2,0),255));
I2lin = min(max(I2,0),255) / 255;
I2srgb = lin2srgb(I2lin);
I2u8 = uint8(min(max(round(I2srgb*255),0),255));
figure();
subplot(122);
imshow(I2u8);title('Proceed');
subplot(121);
imshow(uint8(I));title('Original');

%% Helpers

function lin = srgb2lin(s)
    a = 0.055;
    lin = zeros(size(s));
    m = (s <= 0.04045);
    lin(m)  = s(m) / 12.92;
    lin(~m) = ((s(~m) + a) / (1+a)).^2.4;
end

function s = lin2srgb(lin)
    a = 0.055;
    s = zeros(size(lin));
    m = (lin <= 0.0031308);
    s(m)  = 12.92 * lin(m);
    s(~m) = (1+a) * (lin(~m).^(1/2.4)) - a;
end
